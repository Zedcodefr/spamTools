# Caddy : certificat HTTPS automatique pour {$DOMAIN}, accès protégé par mot de passe.
# L'application n'a pas de comptes : sans ce mot de passe, n'importe qui pourrait modifier
# les decks et la collection.
{$DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
