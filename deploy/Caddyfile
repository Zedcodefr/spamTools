# Caddy (profil « caddy » de compose.yaml) : certificat HTTPS automatique pour {$DOMAIN}.
# Le mot de passe d'accès est vérifié par l'application elle-même (SPAMTOOLS_AUTH_*).
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy app:3000
}
