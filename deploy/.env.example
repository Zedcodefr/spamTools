# Copier en deploy/.env (jamais commité) et remplir.

# Accès protégé par mot de passe (vérifié par l'application, toutes les pages et l'API).
SPAMTOOLS_AUTH_USER=moi
# Empreinte du mot de passe (12 caractères au moins), générée après le build de l'image avec :
#   printf '%s' 'mon mot de passe' | docker run --rm -i spamtools:latest hash-password
SPAMTOOLS_AUTH_PASSWORD_HASH=scrypt:remplacer:par-votre-empreinte

# Adresse où le reverse proxy joint l'application (jamais 0.0.0.0).
# Derrière le nginx de mailcow : adresse de host.docker.internal vue par nginx, soit le pont docker0
# (docker exec <nginx> getent hosts host.docker.internal), en général 172.17.0.1:3100.
SPAMTOOLS_BIND=127.0.0.1:3100

# Uniquement avec Caddy (--profile caddy) : domaine pointant vers le serveur.
# DOMAIN=spamtools.example.fr
