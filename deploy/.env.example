# Copier en deploy/.env (jamais commité) et remplir.

# Nom de domaine pointant vers le serveur (enregistrement DNS A/AAAA) : Caddy obtient le certificat HTTPS.
DOMAIN=spamtools.example.fr

# Accès protégé par mot de passe.
BASIC_AUTH_USER=moi
# Empreinte bcrypt du mot de passe, générée avec :
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'mon-mot-de-passe'
# Docker Compose interprète les « $ » : les doubler (chaque $ devient $$).
BASIC_AUTH_HASH=$$2a$$14$$remplacer.par.votre.empreinte
